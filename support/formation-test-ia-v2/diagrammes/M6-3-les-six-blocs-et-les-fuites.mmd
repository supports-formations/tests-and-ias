flowchart TB
  subgraph JOB["Le job de test — six blocs"]
    direction TB
    B1["B1 DECLENCHEUR<br/>qui peut lancer, sur quel code"]
    B2["B2 PERMISSIONS<br/>lecture seule par defaut"]
    B3["B3 BUDGET<br/>delai du job · tours de l'agent · cout"]
